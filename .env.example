# DailyDo SaaS — un seul projet Supabase pour tous les restaurants
# Récupère la clé anon : Supabase → Project Settings → API → anon public
#
# URL affichée aux utilisateurs (Auth Supabase : ajoutez aussi cette URL dans Redirect URLs)
# VITE_APP_ORIGIN=https://www.dailydo-saas.app

# Ex. https://jgesheqrpskfygaxdncl.supabase.co (Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://VOTRE_REF_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=REMPLACER_PAR_CLE_ANON_SUPABASE
